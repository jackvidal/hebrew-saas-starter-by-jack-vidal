# ─── Supabase ─────────────────────────────────────────────
# Project Settings → API Keys (or "Connect" button → App Frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Database (Prisma) ────────────────────────────────────
# "Connect" button → ORMs → Prisma. Both URLs need [YOUR-PASSWORD] replaced.
# URL-ENCODE the password if it has special characters (& → %26, @ → %40, ! → %21).
# Easier: reset the DB password to alphanumeric only.
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-1-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.xxxxx:PASSWORD@aws-1-region.pooler.supabase.com:5432/postgres

# ─── Anthropic ────────────────────────────────────────────
# Get a key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Webhook secret (Cal.com or other) ────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAL_WEBHOOK_SECRET=whsec_...

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
